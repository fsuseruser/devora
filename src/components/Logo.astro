---
import Mark from './Mark.astro';
interface Props { class?: string; co?: boolean; dot?: string }
const { class: cls = '', co = true, dot } = Astro.props;
---
<span class:list={['logo inline-flex items-baseline whitespace-nowrap', cls]}>
  <span class="logo-word">DEV<Mark class="logo-o" weight={26} dot={dot} />RA</span>
  {co && <span class="logo-co serif">&amp; Co.</span>}
</span>

<style>
  .logo { font-family: var(--font-brand); font-weight: 550; letter-spacing: 0.16em; line-height: 1; }
  .logo-word { display: inline-flex; align-items: center; }
  .logo :global(.logo-o) { width: 0.98em; height: 0.98em; margin: 0 0.12em 0 0.02em; transform: translateY(-0.02em); }
  .logo-co { font-size: 1.05em; letter-spacing: 0; margin-left: 0.15em; font-weight: 400; }
</style>
