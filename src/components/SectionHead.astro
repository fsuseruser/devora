---
interface Props { index?: string; label: string; class?: string; dark?: boolean }
const { index, label, class: cls = '', dark = false } = Astro.props;
---
<div class:list={['flex items-center gap-4', cls]} data-reveal>
  {index && <span class:list={['label', dark ? 'text-bronze-light' : 'text-bronze']}>{index}</span>}
  <span class:list={['h-px w-10', dark ? 'bg-paper/25' : 'bg-ink/20']}></span>
  <span class:list={['label', dark ? 'text-paper/60' : 'text-muted']}>{label}</span>
</div>
