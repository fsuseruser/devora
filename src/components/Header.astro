---
import Logo from './Logo.astro';
import { site } from '../data/site';
const path = Astro.url.pathname;
---
<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50" data-tone="light">
  <div class="wrap flex h-[76px] items-center justify-between">
    <a href="/" class="relative z-10 text-[1.02rem] md:text-[1.12rem]" aria-label={`${site.name} — home`}>
      <Logo />
    </a>
    <nav class="hidden items-center gap-9 md:flex" aria-label="Primary">
      {site.nav.map((n) => (
        <a href={n.href} class:list={['nav-link text-[0.92rem]', path.startsWith(n.href) && 'is-active']} data-cursor="link">
          <span class="nav-roll" data-text={n.label}><span>{n.label}</span></span>
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/contact/" class="btn btn-dark hidden !py-3 !px-5 text-sm md:inline-flex header-cta" data-cursor="link">
        Start a project <span class="arrow">→</span>
      </a>
      <button id="menu-btn" class="menu-btn relative z-10 grid md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-40 bg-forest text-paper md:hidden" aria-hidden="true">
  <div class="wrap flex h-full flex-col justify-between pt-28 pb-10">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      <a href="/" class="mm-link display text-[3.4rem]"><span>Home</span></a>
      {site.nav.map((n) => <a href={n.href} class="mm-link display text-[3.4rem]"><span>{n.label}</span></a>)}
    </nav>
    <div class="mm-foot space-y-2 text-paper/70">
      <a href={`mailto:${site.email}`} class="block text-lg text-paper">{site.email}</a>
      <p class="label">{site.address.city} · {site.address.country}</p>
    </div>
  </div>
</div>

<style>
  .site-header { color: var(--color-ink); transition: color 0.5s, transform 0.6s var(--ease-out-expo), background-color 0.5s; }
  .site-header::before {
    content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity 0.5s;
    background: color-mix(in oklab, var(--color-paper) 78%, transparent); backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 8%, transparent);
  }
  .site-header.is-scrolled::before { opacity: 1; }
  .site-header[data-tone='dark'] { color: var(--color-paper); }
  .site-header[data-tone='dark']::before { background: color-mix(in oklab, var(--color-ink) 60%, transparent); border-color: rgb(255 255 255 / 0.06); }
  .site-header[data-tone='dark'] .header-cta { background: var(--color-paper); color: var(--color-ink); }
  .site-header.is-hidden { transform: translateY(-100%); }
  .site-header.menu-open { color: var(--color-paper); transform: none; }
  .site-header.menu-open::before { opacity: 0; }

  .nav-roll { position: relative; display: inline-block; overflow: hidden; vertical-align: top; }
  .nav-roll > span { display: inline-block; transition: transform 0.55s var(--ease-out-expo); }
  .nav-roll::after { content: attr(data-text); position: absolute; left: 0; top: 100%; transition: transform 0.55s var(--ease-out-expo); }
  .nav-link:hover .nav-roll > span, .nav-link:hover .nav-roll::after { transform: translateY(-100%); }
  .nav-link { position: relative; }
  .nav-link.is-active::before { content: ''; position: absolute; left: -12px; top: 50%; width: 5px; height: 5px; margin-top: -2px; border-radius: 50%; background: var(--color-bronze-light); }

  .menu-btn { width: 44px; height: 44px; place-content: center; gap: 7px; }
  .menu-btn span { display: block; width: 26px; height: 1.5px; background: currentColor; transition: transform 0.5s var(--ease-out-expo); }
  .menu-btn[aria-expanded='true'] span:first-child { transform: translateY(4.25px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:last-child { transform: translateY(-4.25px) rotate(-45deg); }

  .mobile-menu { clip-path: inset(0 0 100% 0); transition: clip-path 0.8s var(--ease-in-out-quart); visibility: hidden; }
  .mobile-menu.is-open { clip-path: inset(0 0 0 0); visibility: visible; }
  .mm-link { display: block; overflow: hidden; }
  .mm-link span { display: block; transform: translateY(105%); transition: transform 0.8s var(--ease-out-expo); }
  .mobile-menu.is-open .mm-link span { transform: none; }
  .mobile-menu.is-open .mm-link:nth-child(2) span { transition-delay: 0.05s; }
  .mobile-menu.is-open .mm-link:nth-child(3) span { transition-delay: 0.1s; }
  .mobile-menu.is-open .mm-link:nth-child(4) span { transition-delay: 0.15s; }
  .mobile-menu.is-open .mm-link:nth-child(5) span { transition-delay: 0.2s; }
</style>
