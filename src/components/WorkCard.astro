---
import type { Project } from '../data/projects';
import { categories } from '../data/projects';
interface Props { project: Project; index: number; aspect?: string; class?: string; reveal?: boolean }
const { project: p, index, aspect = 'aspect-[16/11]', class: cls = '', reveal = true } = Astro.props;
const catLabels = p.categories.map((c) => categories.find((x) => x.id === c)?.label).join(' · ');
---
<article class:list={['work-card group', cls]} data-cats={p.categories.join(' ')}>
  <a href={`/work/${p.slug}/`} class="block" data-cursor="view" data-cursor-label="View">
    <div class:list={['frame wc-frame rounded-[4px]', aspect]} data-clip={reveal ? '' : undefined}>
      <img src={p.cover} alt={`${p.title} — ${p.summary}`} loading="lazy" width="1600" height="1100" data-parallax="4" />
      <span class="wc-tag label">{catLabels}</span>
    </div>
    <div class="mt-5 flex items-start justify-between gap-6" data-reveal={reveal ? '' : undefined}>
      <div>
        <h3 class="wc-title text-[1.5rem] font-medium tracking-[-0.03em] md:text-[1.9rem]">
          <span class="label mr-3 align-middle text-bronze">{String(index + 1).padStart(2, '0')}</span>{p.title}
        </h3>
        <p class="mt-1.5 max-w-[46ch] text-[0.95rem] text-muted">{p.summary}</p>
      </div>
      <span class="label shrink-0 pt-2 text-muted">{p.year}</span>
    </div>
  </a>
</article>

<style>
  .wc-frame img { transform-origin: center; }
  .wc-frame::after { content: ''; position: absolute; inset: 0; background: var(--color-forest); opacity: 0; mix-blend-mode: multiply; transition: opacity 0.8s var(--ease-out-expo); }
  .work-card:hover .wc-frame::after { opacity: 0.22; }
  .wc-tag {
    position: absolute; left: 1rem; top: 1rem; z-index: 2; padding: 0.45rem 0.7rem; border-radius: 999px;
    background: color-mix(in oklab, var(--color-paper) 88%, transparent); backdrop-filter: blur(8px); color: var(--color-ink);
    transform: translateY(-8px); opacity: 0; transition: all 0.6s var(--ease-out-expo);
  }
  .work-card:hover .wc-tag { transform: none; opacity: 1; }
  @media (hover: none) { .wc-tag { opacity: 1; transform: none; } }
  .wc-title { transition: transform 0.7s var(--ease-out-expo); }
  .work-card:hover .wc-title { transform: translateX(6px); }
</style>
