---
import { services } from '../data/services';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<ul class:list={['svc-index border-t', dark ? 'border-paper/15' : 'border-ink/15', dark && 'is-dark']}>
  {services.map((s) => (
    <li class:list={['svc-row border-b', dark ? 'border-paper/15' : 'border-ink/15']} data-reveal>
      <a href={`/services/${s.slug}/`} class="svc-link block" data-cursor="link">
        <div class="svc-head grid grid-cols-[3rem_1fr_auto] items-center gap-4 py-6 md:grid-cols-[6rem_1.4fr_1fr_auto] md:gap-8 md:py-8">
          <span class="label svc-n">{s.n}</span>
          <h3 class="svc-title text-[1.55rem] font-medium leading-[1.05] tracking-[-0.035em] md:text-[2.6rem]">{s.title}</h3>
          <p class="svc-short hidden max-w-[40ch] text-[0.95rem] md:block">{s.short}</p>
          <span class="svc-arrow grid h-11 w-11 place-items-center rounded-full border text-lg md:h-14 md:w-14">→</span>
        </div>
        <div class="svc-reveal" aria-hidden="true">
          <div class="overflow-hidden">
            <div class="grid gap-6 pb-8 md:grid-cols-[6rem_1.4fr_1fr_auto] md:gap-8">
              <span class="hidden md:block"></span>
              <div class="frame svc-img aspect-[16/7] rounded-[4px]"><img src={s.image} alt="" loading="lazy" width="1600" height="1100" /></div>
              <ul class="svc-tags flex flex-wrap content-start gap-2">
                {s.deliverables.slice(0, 5).map((d) => <li class="rounded-full border px-3 py-1.5 text-[0.8rem]">{d}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .svc-row { position: relative; }
  .svc-link { position: relative; isolation: isolate; }
  .svc-link::before { content: ''; position: absolute; inset: 0 -1.5rem; z-index: -1; background: var(--color-stone-100); transform: scaleY(0); transform-origin: bottom; transition: transform 0.7s var(--ease-out-expo); border-radius: 4px; }
  .is-dark .svc-link::before { background: var(--color-ink-2); }
  .svc-n { color: var(--color-bronze); }
  .is-dark .svc-n { color: var(--color-bronze-light); }
  .svc-short { color: var(--color-muted); }
  .is-dark .svc-short { color: rgb(243 239 228 / 0.6); }
  .svc-title { transition: transform 0.7s var(--ease-out-expo); }
  .svc-arrow { border-color: currentColor; opacity: 0.6; transition: all 0.6s var(--ease-out-expo); }
  .svc-tags li { border-color: color-mix(in oklab, currentColor 25%, transparent); }
  .svc-reveal { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.8s var(--ease-out-expo); }
  .svc-img img { transform: scale(1.15); transition: transform 1.2s var(--ease-out-expo); }
  @media (hover: hover) {
    .svc-link:hover::before { transform: scaleY(1); }
    .svc-link:hover .svc-title { transform: translateX(10px); }
    .svc-link:hover .svc-arrow { opacity: 1; background: var(--color-forest); color: var(--color-paper); border-color: var(--color-forest); transform: rotate(-45deg); }
    .is-dark .svc-link:hover .svc-arrow { background: var(--color-bronze-light); border-color: var(--color-bronze-light); color: var(--color-ink); }
    .svc-link:hover .svc-reveal { grid-template-rows: 1fr; }
    .svc-link:hover .svc-img img { transform: scale(1); }
  }
</style>
