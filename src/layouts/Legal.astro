---
import Base from './Base.astro';
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<Base title={title}>
  <section class="bg-paper pt-36 pb-28 md:pt-48 md:pb-40" data-tone="light">
    <div class="wrap grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="label text-muted">Legal · Updated {updated}</p>
        <h1 class="h-lg display mt-6" data-lines><span class="line-mask"><span>{title}</span></span></h1>
      </div>
      <article class="legal md:col-span-7 md:col-start-6" data-reveal><slot /></article>
    </div>
  </section>
</Base>
<style>
  .legal :global(h2) { font-size: 1.35rem; font-weight: 500; letter-spacing: -0.02em; margin: 2.5rem 0 0.75rem; }
  .legal :global(p), .legal :global(li) { color: color-mix(in oklab, var(--color-ink) 75%, transparent); line-height: 1.7; }
  .legal :global(ul) { list-style: disc; padding-left: 1.2rem; margin-top: 0.5rem; }
  .legal :global(a) { text-decoration: underline; }
</style>
