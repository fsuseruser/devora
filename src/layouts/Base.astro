---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; image?: string; loader?: boolean }
const { title, description = site.description, image = '/images/site/hero-center.jpg', loader = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline.replace('.', '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  slogan: site.tagline,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', streetAddress: site.address.line1, addressLocality: site.address.city, addressCountry: 'AE' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/devora-app-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a2e22" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!rm) document.documentElement.classList.add('motion');
      })();
    </script>
  </head>
  <body>
    {loader && (
      <div id="loader" class="loader fixed inset-0 z-[100] grid place-items-center bg-forest text-paper" aria-hidden="true">
        <div class="loader-inner flex flex-col items-center gap-6">
          <Mark class="loader-mark h-16 w-16" weight={30} />
          <span class="label loader-tag text-paper/60">{site.tagline}</span>
        </div>
      </div>
    )}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="cursor" aria-hidden="true"><span>View</span></div>
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .loader-mark :global(.mark-ring circle) { stroke-dasharray: 410; stroke-dashoffset: 410; animation: draw 1s var(--ease-in-out-quart) forwards; }
  .loader-mark :global(.mark-dot) { transform-box: fill-box; transform-origin: center; transform: scale(0); animation: pop 0.5s 0.75s var(--ease-out-expo) forwards; }
  .loader-tag { opacity: 0; animation: fade 0.6s 0.5s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { to { transform: scale(1); } }
  @keyframes fade { to { opacity: 1; } }
  .loader.is-done { clip-path: inset(0 0 100% 0); transition: clip-path 0.9s var(--ease-in-out-quart); }
  .loader.is-skip { display: none; }
</style>
