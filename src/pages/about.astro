---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Principles from '../components/Principles.astro';
import Marquee from '../components/Marquee.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
---
<Base title="Studio" description="DEVORA & Co. is a digital development studio in Abu Dhabi designing premium websites, applications and business systems.">
  <PageHeader label="The studio" meta={`Est. ${site.founded} · ${site.address.city}`} lines={['Digital craft,']} accent="beyond the ordinary." intro="We started DEVORA & Co. with a simple belief: the companies shaping this region deserve digital experiences as ambitious as their vision." />

  <section class="bg-paper" data-tone="light">
    <div class="wrap grid gap-6 md:grid-cols-12">
      <div class="frame aspect-[4/3] rounded-[4px] md:col-span-8" data-clip><img src="/images/site/studio.jpg" alt="Light and shadow across the studio wall" width="1600" height="1100" data-parallax="8" /></div>
      <div class="frame aspect-[4/3] rounded-[4px] md:col-span-4 md:aspect-auto" data-clip><img src="/images/site/facade.jpg" alt="Glass facade detail" width="1000" height="1400" data-parallax="8" loading="lazy" /></div>
    </div>
  </section>

  <section class="bg-paper py-28 md:py-40" data-tone="light">
    <div class="wrap grid gap-14 md:grid-cols-12">
      <div class="md:col-span-3"><SectionHead index="01" label="Our story" /></div>
      <div class="md:col-span-8 md:col-start-5">
        <p class="h-md !leading-[1.1]" data-words>
          DEVORA &amp; Co. brings strategy, design and engineering together under one roof — a senior team that treats every website, platform and workflow as a product worth getting <span class="serif text-forest">exactly right.</span>
        </p>
        <div class="mt-16 grid gap-10 text-ink/75 md:grid-cols-2">
          <p data-reveal>Based in Abu Dhabi, we partner with founders, developers, family businesses and growing enterprises across the UAE and GCC. We understand the region’s pace, its bilingual audiences and its expectation of quality.</p>
          <p data-reveal>Our name is a promise. “Beyond the Ordinary” means questioning templates, sweating the details others skip and building technology that keeps paying back long after launch day.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-ink py-10 text-paper md:py-14" data-tone="dark">
    <Marquee items={['Strategy', 'Design', 'Engineering', 'Automation', 'Intelligence', 'Care']} class="text-[3rem] font-medium tracking-[-0.04em] md:text-[7rem]" speed={35} />
  </section>

  <section class="bg-paper py-28 md:py-40" data-tone="light">
    <div class="wrap">
      <SectionHead index="02" label="What we believe" />
      <h2 class="h-xl display mt-6 mb-14 md:mb-20" data-lines>
        <span class="line-mask"><span>Principles we</span></span>
        <span class="line-mask"><span><span class="serif text-forest">don’t</span> compromise.</span></span>
      </h2>
      <Principles />
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink text-paper" data-tone="dark">
    <img src="/images/site/arches.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-60" loading="lazy" width="1920" height="1080" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"></div>
    <div class="wrap relative flex min-h-[80svh] flex-col justify-end py-20 md:py-28">
      <SectionHead index="03" label="Where we are" dark />
      <div class="mt-8 grid gap-10 md:grid-cols-12 md:items-end">
        <h2 class="h-xl display md:col-span-7" data-lines>
          <span class="line-mask"><span>Made in</span></span>
          <span class="line-mask"><span class="serif text-bronze-light">Abu Dhabi.</span></span>
        </h2>
        <div class="space-y-4 text-paper/75 md:col-span-4 md:col-start-9" data-reveal>
          <p>{site.address.line1}, {site.address.city}, {site.address.country}</p>
          <p>{site.hours}</p>
          <p>Local time · <span class="font-mono" data-clock>--:--</span></p>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Base>
