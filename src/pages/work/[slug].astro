---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import SectionHead from '../../components/SectionHead.astro';
import { projects, categories } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { project: p, next: projects[(i + 1) % projects.length], index: i } }));
}
const { project: p, next, index } = Astro.props;
const cats = p.categories.map((c) => categories.find((x) => x.id === c)?.label).join(', ');
---
<Base title={p.title} description={p.summary} image={p.cover}>
  <section class="bg-paper pt-36 pb-14 md:pt-48 md:pb-20" data-tone="light">
    <div class="wrap">
      <div class="flex items-center justify-between" data-reveal>
        <a href="/work/" class="label ulink text-muted">← All work</a>
        <span class="label text-muted">Case {String(index + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span>
      </div>
      <h1 class="h-xxl display mt-10" data-lines>
        <span class="line-mask"><span>{p.title}</span></span>
      </h1>
      <div class="mt-12 grid gap-10 border-t border-ink/15 pt-8 md:grid-cols-12">
        <p class="lead text-ink/75 md:col-span-5" data-reveal>{p.summary}</p>
        <dl class="grid grid-cols-2 gap-6 text-sm md:col-span-6 md:col-start-7 md:grid-cols-4">
          {[['Client', p.client], ['Year', p.year], ['Sector', p.sector], ['Discipline', cats]].map(([k, v]) => (
            <div data-reveal><dt class="label text-muted">{k}</dt><dd class="mt-2 font-medium">{v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-paper" data-tone="light">
    <div class="frame h-[62svh] md:h-[92svh]" data-clip>
      <img src={p.cover} alt={p.title} width="1600" height="1100" data-parallax="8" fetchpriority="high" />
    </div>
  </section>

  <section class="bg-paper py-24 md:py-36" data-tone="light">
    <div class="wrap grid gap-16 md:grid-cols-12">
      <div class="md:col-span-3"><SectionHead index="01" label="The brief" /></div>
      <div class="md:col-span-8 md:col-start-5">
        <p class="h-md !leading-[1.12]" data-words>{p.challenge}</p>
        <div class="mt-16 grid gap-10 md:grid-cols-2">
          <div data-reveal>
            <p class="label text-bronze">Our approach</p>
            <p class="mt-4 text-ink/75">{p.approach}</p>
          </div>
          <div data-reveal>
            <p class="label text-bronze">Services</p>
            <ul class="mt-4 space-y-2">{p.services.map((s) => <li class="border-b border-ink/10 pb-2">{s}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper pb-24 md:pb-36" data-tone="light">
    <div class="wrap grid gap-6 md:grid-cols-12">
      <div class="frame aspect-[16/11] rounded-[4px] md:col-span-8" data-clip><img src={p.gallery[0]} alt={`${p.title} detail`} loading="lazy" width="1600" height="1100" data-parallax="6" /></div>
      <div class="frame aspect-[16/11] rounded-[4px] md:col-span-4 md:aspect-auto" data-clip><img src={p.gallery[1]} alt={`${p.title} detail`} loading="lazy" width="1000" height="1400" data-parallax="6" /></div>
    </div>
  </section>

  <section class="bg-ink py-24 text-paper md:py-36" data-tone="dark">
    <div class="wrap">
      <SectionHead index="02" label="Outcomes" dark />
      <div class="mt-12 grid gap-0 md:grid-cols-3">
        {p.results.map((r, i) => (
          <div class:list={['border-t border-paper/15 py-10 md:pr-10', i > 0 && 'md:border-l md:pl-10']} data-reveal>
            <p class="text-[4rem] font-medium leading-none tracking-[-0.05em] md:text-[6.5rem]" data-count={r.value}>{r.value}</p>
            <p class="mt-4 text-paper/60">{r.label}</p>
          </div>
        ))}
      </div>
      <p class="label mt-10 text-paper/35">Placeholder case study — replace with real project data.</p>
    </div>
  </section>

  <a href={`/work/${next.slug}/`} class="next group relative block overflow-hidden bg-paper py-24 md:py-36" data-next data-tone="light" data-cursor="view" data-cursor-label="Next">
    <div class="wrap relative z-10">
      <p class="label text-muted">Next project</p>
      <p class="h-xxl display mt-6 transition-transform duration-700 group-hover:translate-x-4">{next.title}</p>
      <p class="mt-6 max-w-[48ch] text-muted">{next.summary}</p>
    </div>
    <div class="next-img pointer-events-none absolute left-0 top-0 z-0 hidden aspect-[4/3] w-[30vw] overflow-hidden rounded-[4px] md:block" data-next-img>
      <img src={next.cover} alt="" class="h-full w-full object-cover" loading="lazy" />
    </div>
  </a>

  <CTA />
</Base>

<style>
  .next-img { opacity: 0; scale: 0.7; transition: opacity 0.5s, scale 0.8s var(--ease-out-expo); }
  .next:hover .next-img { opacity: 1; scale: 1; }
</style>
