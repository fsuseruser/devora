---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import { services } from '../../data/services';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return services.map((s, i) => ({ params: { slug: s.slug }, props: { service: s, next: services[(i + 1) % services.length] } }));
}
const { service: s, next } = Astro.props;
const related = projects.filter((p) => p.categories.includes(s.category as any)).slice(0, 2);
---
<Base title={s.title} description={s.short} image={s.image}>
  <section class="bg-paper pt-36 pb-16 md:pt-48 md:pb-24" data-tone="light">
    <div class="wrap">
      <div class="flex items-center justify-between" data-reveal>
        <a href="/services/" class="label ulink text-muted">← All services</a>
        <span class="label text-muted">Service {s.n} / 06</span>
      </div>
      <h1 class="h-xl display mt-10 max-w-[15ch]" data-lines>
        {s.title.split(' & ').map((part, i, arr) => (
          <span class="line-mask"><span>{i === arr.length - 1 && arr.length > 1 ? <><span class="serif text-forest">&amp; </span>{part}</> : part}</span></span>
        ))}
      </h1>
      <p class="lead mt-10 max-w-[56ch] text-ink/75 md:ml-[33%]" data-reveal>{s.intro}</p>
    </div>
  </section>

  <section class="bg-paper" data-tone="light">
    <div class="wrap">
      <div class="frame aspect-[16/9] rounded-[4px] md:aspect-[21/9]" data-clip><img src={s.image} alt={s.title} width="1600" height="1100" data-parallax="8" /></div>
    </div>
  </section>

  <section class="bg-paper py-24 md:py-36" data-tone="light">
    <div class="wrap grid gap-14 md:grid-cols-12">
      <div class="md:col-span-4">
        <SectionHead index="01" label="What’s included" />
        <h2 class="h-md mt-6 max-w-[14ch]" data-reveal>Everything needed to do it <span class="serif text-forest">properly.</span></h2>
      </div>
      <ol class="md:col-span-7 md:col-start-6">
        {s.deliverables.map((d, i) => (
          <li class="deliv flex items-baseline gap-6 border-t border-ink/15 py-5 last:border-b md:py-6" data-reveal>
            <span class="label text-bronze">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[1.3rem] font-medium tracking-[-0.025em] md:text-[1.7rem]">{d}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-forest py-24 text-paper md:py-36" data-tone="dark">
    <div class="wrap">
      <SectionHead index="02" label="Outcomes" dark />
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {s.outcomes.map((o, i) => (
          <div class="rounded-[6px] border border-paper/12 p-8 md:min-h-[300px]" data-reveal>
            <span class="label text-bronze-light">0{i + 1}</span>
            <h3 class="mt-16 text-[2rem] font-medium tracking-[-0.04em]">{o.title}</h3>
            <p class="mt-3 text-paper/65">{o.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-16 flex flex-col gap-6 md:flex-row md:items-center" data-reveal>
        <p class="label shrink-0 text-paper/50">Tools we use</p>
        <ul class="flex flex-wrap gap-2">{s.stack.map((t) => <li class="rounded-full border border-paper/20 px-4 py-2 text-sm">{t}</li>)}</ul>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-paper py-24 md:py-36" data-tone="light">
      <div class="wrap">
        <div class="mb-12 flex items-end justify-between">
          <div>
            <SectionHead index="03" label="Related work" />
            <h2 class="h-lg display mt-6" data-reveal>In <span class="serif text-forest">practice.</span></h2>
          </div>
          <a href="/work/" class="ulink hidden font-medium md:inline">All work →</a>
        </div>
        <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
          {related.map((p) => <WorkCard project={p} index={projects.indexOf(p)} />)}
        </div>
      </div>
    </section>
  )}

  <a href={`/services/${next.slug}/`} class="group block border-t border-ink/10 bg-paper py-20 md:py-28" data-tone="light" data-cursor="view" data-cursor-label="Next">
    <div class="wrap flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="label text-muted">Next service · {next.n}</p>
        <p class="h-lg display mt-5 max-w-[18ch] transition-transform duration-700 group-hover:translate-x-3">{next.title}</p>
      </div>
      <span class="grid h-16 w-16 place-items-center rounded-full border border-ink/30 text-2xl transition-all duration-700 group-hover:-rotate-45 group-hover:bg-forest group-hover:text-paper">→</span>
    </div>
  </a>

  <CTA />
</Base>
